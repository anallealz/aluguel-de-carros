('88888888888', 'Charlie', 'Brown', 'Rua H, 800', 'charlie.brown@email.com')
ON CONFLICT (cpf) DO UPDATE
SET
    nome = EXCLUDED.nome,
    sobrenome = EXCLUDED.sobrenome,
    endereco = EXCLUDED.endereco,
    email = EXCLUDED.email;


-- 2. DADOS BANCÁRIOS

INSERT INTO dados_bancarios (id_pessoa, banco, agencia, conta)
SELECT
    p.id_pessoa,
    dados.banco,
    dados.agencia,
    dados.conta
FROM (
    VALUES
    ('11111111111', 'Nubank', '0001', '10001-0'),
    ('22222222222', 'Itaú', '0001', '20002-0'),
    ('33333333333', 'Bradesco', '0001', '30003-0'),
    ('44444444444', 'Banco do Brasil', '0001', '40004-0'),
    ('55555555555', 'Santander', '0001', '50005-0'),
    ('66666666666', 'Caixa', '0001', '60006-0'),
    ('77777777777', 'Inter', '0001', '70007-0'),
    ('88888888888', 'Nubank', '0001', '80008-0')
) AS dados(cpf, banco, agencia, conta)
JOIN pessoa p
    ON p.cpf = dados.cpf
ON CONFLICT (id_pessoa) DO UPDATE
SET
    banco = EXCLUDED.banco,
    agencia = EXCLUDED.agencia,
    conta = EXCLUDED.conta;



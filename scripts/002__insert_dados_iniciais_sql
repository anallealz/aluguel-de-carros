-- 4. CONTRATOS

INSERT INTO contrato
(numero_contrato, tipo_pagamento, data_inicio, data_fim, id_pessoa, id_veiculo)

SELECT
    dados.numero_contrato,
    dados.tipo_pagamento,
    dados.data_inicio,
    dados.data_fim,
    p.id_pessoa,
    v.id_veiculo
FROM (
    VALUES
    ('CTR001', 'PIX', DATE '2026-06-05', DATE '2026-06-10', '11111111111', 'ABC1D23'),
    ('CTR002', 'Cartão', DATE '2026-06-18', DATE '2026-06-25', '22222222222', 'DEF4G56'),
    ('CTR003', 'PIX', DATE '2026-07-02', DATE '2026-07-06', '33333333333', 'STU7V89'),
    ('CTR004', 'Cartão', DATE '2026-07-15', DATE '2026-07-20', '44444444444', 'KLM1N23'),
    ('CTR005', 'PIX', DATE '2026-07-28', DATE '2026-08-03', '55555555555', 'GHI7J89'),
    ('CTR006', 'Cartão', DATE '2026-08-08', DATE '2026-08-13', '66666666666', 'WXY1Z23'),
    ('CTR007', 'PIX', DATE '2026-08-17', DATE '2026-08-22', '77777777777', 'OPQ4R56'),
    ('CTR008', 'Cartão', DATE '2026-08-26', DATE '2026-08-30', '88888888888', 'ABC1D23'),
    ('CTR009', 'PIX', DATE '2026-09-01', DATE '2026-09-07', '11111111111', 'AAA4B56'),
    ('CTR010', 'Cartão', DATE '2026-09-10', DATE '2026-09-15', '22222222222', 'EEE1F23')
) AS dados(
    numero_contrato,
    tipo_pagamento,
    data_inicio,
    data_fim,
    cpf,
    placa
)
JOIN pessoa p
    ON p.cpf = dados.cpf
JOIN veiculo v
    ON v.placa = dados.placa

ON CONFLICT (numero_contrato) DO UPDATE
SET
    tipo_pagamento = EXCLUDED.tipo_pagamento,
    data_inicio = EXCLUDED.data_inicio,
    data_fim = EXCLUDED.data_fim,
    id_pessoa = EXCLUDED.id_pessoa,
    id_veiculo = EXCLUDED.id_veiculo;


-- 5. ATENDENTES

INSERT INTO atendente (id_pessoa)
SELECT id_pessoa
FROM pessoa
WHERE cpf IN (
    '11111111111',
    '22222222222'
)
ON CONFLICT (id_pessoa) DO NOTHING;
